# ═══════════════════════════════════════════════════════════════
# .env.example
#
# Copy to .env and fill in YOUR actual values.
# NEVER commit .env to git!
# ═══════════════════════════════════════════════════════════════

# Environment: development or production
ENVIRONMENT=development
DEBUG=True

# JWT Secret Key
JWT_SECRET_KEY=your-secret-key-here

JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# PostgreSQL Database on Railway
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:port/railway

# Razorpay Payment Gateway (optional for now)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_secret

# Email Configuration (optional for now)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-password

# FastAPI Server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Frontend & API URLs
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api

# ML Model Paths
RANK_MODEL_PATH=backend/data/cleaned/rank_model_final.pkl
CUTOFF_MODEL_PATH=backend/data/cleaned/cutoff_predictor.pkl
COLLEGE_CODES_PATH=backend/data/cleaned/college_codes.csv
COURSE_CODES_PATH=backend/data/cleaned/course_codes.csv
